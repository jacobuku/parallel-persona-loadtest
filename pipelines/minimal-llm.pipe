    {
      "id": "agent_min",
      "provider": "agent_deepagent",
      "name": "Minimal Responder",
      "config": {
        "profile": "default",
        "default": {
          "advanced_mode": true,
          "agent_description": "Minimal responder — answers the user's text directly in one LLM turn. No tools, no delegation.",
          "system_prompt": "You are a minimal echo-and-answer assistant used to smoke-test a RocketRide pipeline.\n\nYou have NO tools and NO subagents. Do not attempt to call any tool. Answer the user's message directly from your own knowledge in a single turn.\n\nKeep replies short — at most three sentences. Reply with plain text only."
        },
        "name": "Minimal Responder"
      },
      "ui": {
        "position": {
          "x": 600,
          "y": 200
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "questions",
          "from": "question_1"
        }
      ]
    },
    {
      "id": "llm_anthropic_min",
      "provider": "llm_anthropic",
      "name": "Anthropic",
      "config": {
        "profile": "claude-sonnet-4-6",
        "claude-sonnet-4-6": {
          "modelSource": "manual",
          "apikey": "${ROCKETRIDE_ANTHROPIC_KEY}"
        },
        "name": "Anthropic"
      },
      "ui": {
        "position": {
          "x": 600,
          "y": 360
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "control": [
        {
          "classType": "llm",
          "from": "agent_min"
        }
      ]
    },
    {
